// nextflow.config
//
// Defaults here are VM/local-friendly (small fixture, local executor).
// For an HPC production run, override via -profile hpc plus a params file,
// e.g.:
//   nextflow run main.nf -entry full_run -profile hpc \
//     -params-file hpc_production.params.yaml
//
// See README.md for the develop-on-VM -> commit -> run-on-HPC workflow.

params {
  base_dir       = "${launchDir}"
  raw_data_root  = "${params.base_dir}/data/raw"
  manifest_dir   = "${params.base_dir}/manifest_files/combined_run"
  classifier     = "${params.base_dir}/classifier/assets/silva-138-99-515F-806R-classifier.qza"
  output_dir     = "${params.base_dir}/outputs"
  results_dir    = "${params.base_dir}/results"
  prefix         = "rumen_combined"

  // Extra Apptainer bind-mounts beyond base_dir itself (comma-separated),
  // needed on the HPC to make the raw FASTQ root visible inside the
  // container. Empty by default -- the VM/local profile doesn't use
  // Apptainer at all.
  extra_binds    = ""

  // Primer lengths, not read-quality trimming: must match
  // classifier/build/extract_reads_515F_806R.slurm's actual primers
  // (515F GTGCCAGCMGCCGCGGTAA = 19bp, 806R GGACTACHVGGGTWTCTAAT = 20bp).
  // Previously 17/21, left over from the superseded 341F/806R primer pair
  // (see classifier/legacy_341F_806R/) -- never updated when the
  // classifier was corrected, so every read still carried 2bp of residual
  // forward-primer sequence.
  trim_left_f = 19
  trim_left_r = 20
  trunc_len_f = 230
  trunc_len_r = 200
}

process {
  errorStrategy = 'retry'
  maxRetries = 2
}

profiles {
  // Default: local executor, no container, for VM development and
  // running against a small fixture. Requires qiime2 importable in
  // whatever environment `nextflow run` is launched from.
  standard {
    process.executor = 'local'
  }

  // VM/local test-bed using the same image the HPC Apptainer .sif is built
  // from (build_sif.slurm pulls docker://ghcr.io/dermok1010/rumen-microbiome-pipeline:latest)
  // -- no local qiime2 install needed, and the container is guaranteed to
  // match what production actually runs. Processes reference absolute host
  // paths (manifest files point at raw FASTQs by their real path, not via
  // Nextflow path inputs), so bind-mount base_dir to itself, same approach
  // as the hpc profile's apptainer.runOptions bind.
  docker_local {
    process.executor = 'local'
    process.container = 'ghcr.io/dermok1010/rumen-microbiome-pipeline:latest'
    docker.enabled = true
    docker.runOptions = "-v ${params.base_dir}:${params.base_dir}"
  }

  // HPC production profile: Slurm + Apptainer, matching how this pipeline
  // actually runs on the institutional cluster.
  hpc {
    process {
      executor = 'slurm'
      queue = 'Background'
      cpus = 8
      memory = '24 GB'
      clusterOptions = '--output=slurm-%j.out --error=slurm-%j.err'
      container = "${params.base_dir}/rumen_microbiome_pipeline.sif"

      withName: 'dada2_denoise' {
        memory = '32 GB'  // DADA2 is the heavy step and runs once per flowcell; nodes have 385 GB
      }
    }

    // import_reads/dada2_denoise run once per flowcell and are fully
    // independent of each other -- with 17 flowcells now (up from a
    // smaller set before clover22/CRT23/Tully), 6 concurrent Slurm
    // sub-jobs meant ~3 sequential waves. Raised to let most/all flowcells
    // run in parallel; drop this back down if it starves other Background
    // queue users or the actual node count can't support it.
    executor.queueSize = 16

    apptainer.enabled = true
    apptainer.autoMounts = true
    apptainer.runOptions = "--bind ${params.raw_data_root},${params.base_dir}${params.extra_binds ? ',' + params.extra_binds : ''}"
  }
}
