# ------------------------
# Raw sequencing data / large binary assets
# ------------------------
data/raw/
*.fastq
*.fastq.gz
classifier/assets/*.qza
*.qza
*.qzv
*.biom
*.sif

# ------------------------
# Nextflow run state
# ------------------------
work/
.nextflow/
.nextflow.log*
trace.txt
timeline.html
report.html
dag.html

# ------------------------
# Generated outputs (regenerable by running the pipeline)
# ------------------------
outputs/
results/
# dated snapshots kept for before/after comparison, e.g. results_2026-09-15/
results_*/
per_batch/
exported/

# ------------------------
# Generated manifests (regenerable from make_manifests.py)
# ------------------------
manifest_files/

# ------------------------
# Postprocessing notebook outputs (regenerable by running postprocessing/*.ipynb)
# ------------------------
postprocessing/output/
postprocessing/output_*/
postprocessing/phenotype_merge_scripts/output/

# ------------------------
# Logs
# ------------------------
*.log
*.out
*.err
slurm-*.out
slurm-*.err
logs/

# ------------------------
# Python / R / editor
# ------------------------
__pycache__/
*.py[cod]
.Rhistory
.RData
*.ipynb_checkpoints/
.DS_Store
*.tmp
*~
